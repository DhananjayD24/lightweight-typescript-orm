# Server Configuration
PORT=5000
NODE_ENV=development

# Postgres Database Connection URL (Neon / Supabase / Serverless Postgres)
# Example Neon connection string: postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://your_user:your_password@your_neon_host.neon.tech/your_db?sslmode=require

# SSL Configuration
DB_SSL=true
