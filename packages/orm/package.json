{
  "name": "lightweight-ts-orm",
  "version": "1.0.0",
  "description": "A lightweight, type-safe TypeScript ORM for serverless Postgres SQL databases",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "sync": "ts-node src/cli.ts sync"
  },
  "keywords": [
    "orm",
    "typescript",
    "postgres",
    "serverless",
    "type-safe",
    "sql"
  ],
  "dependencies": {
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "license": "MIT"
}
