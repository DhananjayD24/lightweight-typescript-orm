{
  "name": "lightweight-ts-orm",
  "version": "1.0.0",
  "type": "module",
  "description": "A lightweight, type-safe TypeScript ORM for serverless Postgres SQL databases using ES Modules",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "sync": "tsx src/cli.ts sync"
  },
  "keywords": [
    "orm",
    "typescript",
    "postgres",
    "serverless",
    "esm",
    "modular-js",
    "type-safe",
    "sql"
  ],
  "dependencies": {
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "license": "MIT"
}
